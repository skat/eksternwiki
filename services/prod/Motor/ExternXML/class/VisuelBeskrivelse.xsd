<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:dmr="http://skat.dk/dmr/2007/05/31/" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://skat.dk/dmr/2007/05/31/" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xs:annotation>
		<xs:documentation>Indeholder visuelle beskrivelsesoplysninger for et køretøj. Et køretøj kan have tilknyttet én eller flere farvekoder. </xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="../types/FarveType.xsd"/>
	<xs:element name="VisuelBeskrivelseFarve" type="dmr:FarveType">
		<xs:annotation>
			<xs:documentation>EU Farvekoder. [Informationen findes i CoC dokumentets felt 40. Værdisæt er:  1 = Hvid 2 = Gul 3 = Orange 4 = Rød 5 = Lilla 6 = Blå 7 = Grøn 8 = Grå 9 = Brun 10 = Sort </xs:documentation>
		</xs:annotation>
	</xs:element>
</xs:schema>
