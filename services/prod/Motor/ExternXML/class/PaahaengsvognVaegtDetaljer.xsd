<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:dmr="http://skat.dk/dmr/2007/05/31/" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://skat.dk/dmr/2007/05/31/" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xs:annotation>
		<xs:documentation>Indeholder vægtoplysninger relateret til påhængsvogn, herunder vogntogvægt og teknisk tilladt påhængsvægt.</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="../types/TalHel6Min0Type.xsd"/>
	<xs:include schemaLocation="../types/PaahaengKarrosseriTypeType.xsd"/>
	<xs:include schemaLocation="../types/PaahaengBremseTypeType.xsd"/>
	<xs:element name="PaahaengsvognVaegtDetaljerVognTogVaegt" type="dmr:TalHel6Min0Type">
		<xs:annotation>
			<xs:documentation>Teknisk tilladt maksimal vogntog vægt målt i kg</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="PaahaengsvognVaegtDetaljerTekniskTilladtPaahaengVaegt" type="dmr:TalHel6Min0Type">
		<xs:annotation>
			<xs:documentation>Teknisk tilladt maksimal vægt af påhæng [Informationen findes - afhængig af påhængsvogn typen - i CoC dokumentets felt 18.1./18.2./18.3./18.3.1./18.4.]</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="PaahaengsvognVaegtDetaljerPaahaengKarrosseriType" type="dmr:PaahaengKarrosseriTypeType">
		<xs:annotation>
			<xs:documentation>Angiver karrosseritypen af påhæng CoC Dokumentets felt: 18.1./18.2./18.3./18.3.1./18.4.  DA = Sættevogn DB = Påhængsvogn med trækstang DC = Kærre DE = Påhængskøretøj med stiv trækstang </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="PaahaengsvognVaegtDetaljerPaahaengBremseType" type="dmr:PaahaengBremseTypeType">
		<xs:annotation>
			<xs:documentation>Angiver typen af påhængsbremse CoC Dokumentets felt: 18.1./18.2./18.3./18.3.1./18.4. BRK = Påhængsvogn med bremser HBD = Påhængsvogn med hydrauliske bremser INB = Påhængsvogn med påløbsbremse (inerti) PNB = Påhængsvogn med trykluftbremser (pneumatisk) PNH = Påhængsvogn med hydrauliske trykluftbremser UNB = Påhængsvogn uden bremser </xs:documentation>
		</xs:annotation>
	</xs:element>
</xs:schema>
