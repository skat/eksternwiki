<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:dmr="http://skat.dk/dmr/2007/05/31/" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://skat.dk/dmr/2007/05/31/" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xs:annotation>
		<xs:documentation>Indeholder konstruktionsmæssige oplysninger om et køretøj, herunder antal aksler, døre, siddepladser, ståpladser, nyttelast, volumensorientering og akselafstand. </xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="../types/TalHel2Min0Type.xsd"/>
	<xs:include schemaLocation="../types/TalHel3Min0Type.xsd"/>
	<xs:include schemaLocation="../types/Tal9Decimaler5Type.xsd"/>
	<xs:include schemaLocation="../types/BolskType.xsd"/>
	<xs:include schemaLocation="../types/TalHel5Min0Type.xsd"/>
	<xs:element name="KonstruktionDetaljerAntalAksler" type="dmr:TalHel2Min0Type">
		<xs:annotation>
			<xs:documentation>Antal aksler på køretøjet [Informationen findes i CoC dokumentets felt 1.]</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="KonstruktionDetaljerAntalDoere" type="dmr:TalHel2Min0Type">
		<xs:annotation>
			<xs:documentation>Antal døre på køretøjet [Informationen findes i CoC dokumentets felt 41.]</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="KonstruktionDetaljerAntalSiddePladser" type="dmr:TalHel3Min0Type">
		<xs:annotation>
			<xs:documentation>Antal siddepladser inklusive fører [Informationen findes i CoC dokumentets felt 42.]</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="KonstruktionDetaljerAntalStaaPladser" type="dmr:TalHel3Min0Type">
		<xs:annotation>
			<xs:documentation>Antal ståpladser [Informationen findes i CoC dokumentets felt 43.]</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="KonstruktionDetaljerNytteLastVaerdi" type="dmr:Tal9Decimaler5Type">
		<xs:annotation>
			<xs:documentation>Gennemsnitlig nyttelastværdi målt i ton Informationen findes i CoC dokumentets felt 49.6</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="KonstruktionDetaljerVolumenOrientering" type="dmr:BolskType">
		<xs:annotation>
			<xs:documentation>Indikator for volumensorientering Inforrmationen findes i CoC dokumentets felt 49.10 </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="KonstruktionDetaljerAkselAfstand" type="dmr:TalHel5Min0Type">
		<xs:annotation>
			<xs:documentation>Akselafstand målt i milimeter [Informationen findes i CoC dokumentets felt 4.]</xs:documentation>
		</xs:annotation>
	</xs:element>
</xs:schema>
