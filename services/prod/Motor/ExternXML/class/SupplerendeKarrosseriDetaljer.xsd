<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:dmr="http://skat.dk/dmr/2007/05/31/" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://skat.dk/dmr/2007/05/31/" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xs:annotation>
		<xs:documentation>Indeholder oplysninger om supplerende karosseri for et køretøj, herunder supplerende karrosseritype. Et karosseri kan have tilknyttet én eller flere supplerende karosserityper.</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="../types/SupplerendeKarrosseriTypeType.xsd"/>
	<xs:element name="SupplerendeKarrosseriDetaljerSupplerendeKarrosseriType" type="dmr:SupplerendeKarrosseriTypeType">
		<xs:annotation>
			<xs:documentation>Supplerende kode for karosseri. Informationen findes i CoC dokumentets felt 38. Værdisættet er: 01 - Åbent lad uden sidefjæle,  02 - Åbent lad med sidefjæle,  03 - Lukket kasse,  04 - Konditioneret karrosseri med isolerede vægge og udstyr til opretholdelse af indvendig temperatur, 05 - Konditioneret karrosseri med isolerede vægge, men uden udstyr til opretholdelse af indvendig temperatur, 06 - Presseningsopbygning,  07 - Veksellad (overbygning kan udskiftes),  08 - Container,  09 - Læssekran (Køretøjer med kroghejs), 10 - Tippelad,  11 - Tank,  12 - Tank beregnet til transport af farligt gods,  13 - Dyretransporter,  14 - Køretøjstransporter,  15 - Cementblander,  16 - Betonkanon,  17 - Tømmer,  18 - Renovationsaggregat,  19 - Fejemaskine, rengørings- og kloakrensning,  20 - Kompressor,  21 - Bådtransporter,  22 - Svæveflytransporter,  23 - Køretøjer til detailhandel eller fremvisning,  24 - Bjærgningsanordning,  25 - Stigekøretøj,  26 - Kranbil 27 - Køretøj med personlift,  28 - Borevogn,  29 - Lavgulvstrailer (Påhængskøretøj med lavt lad),  30 - Glastransporter,  31 - Brandbil, F 32 - Presseningsopbygning,  99 - Karosseri der ikke er inkluderet på denne liste </xs:documentation>
		</xs:annotation>
	</xs:element>
</xs:schema>
