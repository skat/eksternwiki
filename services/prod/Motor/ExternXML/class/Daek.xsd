	<xs:element name="DaekStoerrelse" type="dmr:Tekst20Min1Type">
		<xs:annotation>
			<xs:documentation>Dækstørrelse Informationen findes i CoC dokumentets felt 35 </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="DaekFaelgStoerrelse" type="dmr:Tekst20Min1Type">
		<xs:annotation>
			<xs:documentation>Fælgstørrelse Informationen findes i CoC dokumentets felt 35 </xs:documentation>
