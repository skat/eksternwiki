<?xml version="1.0" encoding="UTF-8"?>
      
      <xs:schema xmlns:skat2012="http://skat.dk/begrebsmodel/2012/01/01/"
                 xmlns:xs="http://www.w3.org/2001/XMLSchema"
                 targetNamespace="http://skat.dk/begrebsmodel/2012/01/01/"
                 elementFormDefault="qualified"
                 version="1.0">
            
            <xs:simpleType name="SprogKodeType">
               <xs:annotation>
                  <xs:documentation>Entydig kode til angivelse af et sprog jf  ISO standard 639-1 (to bogstaver)</xs:documentation>
               </xs:annotation>
               <xs:restriction base="xs:string">
                  <xs:maxLength value="2"/>
                  <xs:pattern value="[A-Z]{2}"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:schema>
